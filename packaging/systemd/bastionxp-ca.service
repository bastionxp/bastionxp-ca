# BastionXP CA server.
#
#   sudo useradd --system --home-dir /var/lib/bastionxp-ca --shell /usr/sbin/nologin bastionxp-ca
#   sudo install -m 755 bxp /usr/local/bin/bxp
#   sudo install -d -m 750 -o root -g bastionxp-ca /etc/bastionxp-ca
#   sudo install -m 640 -o root -g bastionxp-ca bastionxp-ca.yaml /etc/bastionxp-ca/bastionxp-ca.yaml
#       (with data_dir: /var/lib/bastionxp-ca)
#   sudo install -d -m 700 -o bastionxp-ca -g bastionxp-ca /var/lib/bastionxp-ca
#   sudo -u bastionxp-ca bxp init --config /etc/bastionxp-ca/bastionxp-ca.yaml --root-key-out /media/usb/root.key
#   sudo cp bastionxp-ca.service /etc/systemd/system/
#   sudo systemctl enable --now bastionxp-ca
#
# See "Protect the CA keys" in the BastionXP CA documentation for the
# encrypted key passphrase.

[Unit]
Description=BastionXP CA certificate authority
Documentation=https://github.com/bastionxp/bastionxp-ca
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bastionxp-ca
Group=bastionxp-ca
ExecStart=/usr/local/bin/bxp serve --config /etc/bastionxp-ca/bastionxp-ca.yaml
# "systemctl reload bastionxp-ca" re-reads the access rules and the ACME domains.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# If the server's keys are encrypted: the passphrase, sealed to this
# machine's TPM with
#   systemd-creds encrypt --with-key=tpm2 --name=bastionxp-ca-key-passphrase - \
#       /etc/credstore.encrypted/bastionxp-ca-key-passphrase
#LoadCredentialEncrypted=bastionxp-ca-key-passphrase

# No capabilities. To listen on a port below 1024, e.g.
# server.address: ":443", replace the first line with the two after it.
CapabilityBoundingSet=
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The server writes only to its data directory.
StateDirectory=bastionxp-ca
StateDirectoryMode=0700
UMask=0077

# Hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A call outside the filter fails instead of killing the server.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
